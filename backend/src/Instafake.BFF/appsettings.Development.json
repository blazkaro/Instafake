{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IdP": {
    "Domain": "dev-8jabakdlnjgbixjr.us.auth0.com",
    "ClientId": "UILt3MXlCu4AqPDpZ6gJb6ZmE6wBrxkp",
    "Audience": "instafake-api"
  },
  "GrpcServices": {
    "Posts": {
      "Url": "https://instafake-posts-api"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "Multimedia": {
        "Destinations": {
          "dest1": {
            "Address": "https+http://instafake-multimedia"
          }
        }
      },
      "Posts": {
        "Destinations": {
          "dest1": {
            "Address": "https+http://instafake-posts-api"
          }
        }
      },
      "Notifications": {
        "Destinations": {
          "dest1": {
            "Address": "http+http://instafake-notifications"
          }
        }
      }
    },
    "Routes": {
      "MultimediaRoute": {
        "ClusterId": "Multimedia",
        "Match": {
          "Path": "/multimedia/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/multimedia" }
        ]
      },
      "LikesRoute": {
        "ClusterId": "Posts",
        "Match": {
          "Path": "/likes/{**remainder}"
        }
      }
    },
    "NotificationsRoute": {
      "ClusterId": "Notifications",
      "Match": {
        "Path": "/notifications/{**remainder}"
      },
      "Transforms": [
        { "PathRemovePrefix": "/notifications" }
      ]
    }
  }
}
