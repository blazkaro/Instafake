<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <UserSecretsId>9fc692d2-8edb-4a73-b1b2-31cea4ed7875</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
	  <Protobuf Include="Protos\post.proto" GrpcServices="Server" />
	  <Protobuf Include="Protos\Shared\pagination.proto" />
	  <Protobuf Include="Protos\Shared\user.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Instafake.Posts.Application\Instafake.Posts.Application.csproj" />
    <ProjectReference Include="..\Instafake.Posts.Infrastructure\Instafake.Posts.Infrastructure.csproj" />
  </ItemGroup>

</Project>
