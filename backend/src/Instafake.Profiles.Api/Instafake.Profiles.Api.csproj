    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>87596b1e-3cf7-4a5b-b6c3-24ebbb993eef</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
