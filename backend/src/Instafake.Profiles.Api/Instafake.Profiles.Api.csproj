      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Instafake.Profiles.Application\Instafake.Profiles.Application.csproj" />
    <ProjectReference Include="..\Instafake.Profiles.Infrastructure\Instafake.Profiles.Infrastructure.csproj" />
    <ProjectReference Include="..\Instafake.ServiceDefaults\Instafake.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
