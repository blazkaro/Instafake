{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kafka": {
    "Host": {
      "BootstrapServers": "localhost:9092"
    },
    "Consumers": {
      "Users": {
        "GroupId": "instafake-profiles-users"
      },
      "Posts": {
        "GroupId": "instafake-profiles-posts"
      },
      "PostNotifications": {
        "GroupId": "instafake-profiles-post-notifications"
      }
    }
  }
}
